NEBIUS_API_KEY=
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
TAVILY_API_KEY=
REGWATCH_CLASSIFIER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
REGWATCH_EXTRACTOR_MODEL=nvidia/Nemotron-3_5-Lightning
REGWATCH_DB_URL=sqlite:///regwatch.db
# USD per million tokens for the extractor model — Token Factory catalog price, checked 2026-10-10
REGWATCH_EXTRACTOR_PRICE_IN_PER_MTOK=0.06
REGWATCH_EXTRACTOR_PRICE_OUT_PER_MTOK=0.24
# USD per million tokens for the classifier model — Token Factory catalog price, checked 2026-10-10
REGWATCH_CLASSIFIER_PRICE_IN_PER_MTOK=1.00
REGWATCH_CLASSIFIER_PRICE_OUT_PER_MTOK=3.00
# Characters of page markdown sent to the extractor (quotes are validated against the full page)
REGWATCH_NORMALIZE_MAX_CHARS=200000
# EUR-Lex acts longer than this are split per article / amendment point before normalising
# REGWATCH_ACT_SPLIT_MIN_CHARS=20000
# Documents normalised in parallel (model calls overlap; database writes stay sequential)
# REGWATCH_NORMALIZE_CONCURRENCY=4
# Let the extractor (Lightning) reason before answering; off because the trace fills max_tokens
# REGWATCH_EXTRACTOR_THINKING=false
# Recipient of the "Report a wrong call" link on a change page (blank leaves the To: field empty)
REGWATCH_REPORT_EMAIL=
# Tavily `time_range` for the crawl (year | month | week …); the daily Job uses month
REGWATCH_TIME_RANGE=year
# Port the web app listens on (Serverless Endpoint container port)
PORT=8000
# "Let the agent check" on unclear changes: off unless set; the daily caps are hard limits
# REGWATCH_AGENT_ENABLED=false
# REGWATCH_AGENT_DAILY_USD=1.0
# REGWATCH_AGENT_DAILY_CREDITS=60
# REGWATCH_AGENT_RUN_STEPS=6
# REGWATCH_AGENT_RUN_CREDITS=10
# REGWATCH_AGENT_VISITOR_RUNS_PER_HOUR=5
# Make /profile read-only (the public demo shares one store profile)
# REGWATCH_PROFILE_LOCKED=false
